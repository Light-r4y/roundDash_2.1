CONFIG_IDF_TARGET="esp32s3"

# Флеш W25Q128J: 16 МБ, QIO.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP32-S3R8: 8 МБ octal PSRAM — под два кадровых буфера RGB-экрана.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Экран (docs/fw-design.md §3.1). CPU 240 МГц под рендер LVGL, остальное — по
# рекомендациям Espressif для RGB-панелей на ESP32-S3:
#  - код и константы исполняются из PSRAM, поэтому запись во флеш (NVS, OTA)
#    не останавливает вывод кадра;
#  - строка кэша данных 64 байта — шире канал к PSRAM;
#  - прерывания RGB в IRAM и перезапуск DMA на каждом VSYNC — картинка не
#    съезжает навсегда после одного сбоя.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Шрифты тестового экрана (14 включён по умолчанию).
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Консоль только на UART0. Из его ножек живой остаётся одна TX (GPIO43): RX
# (GPIO44) занят кнопкой 2. USB-Serial/JTAG выключен совсем — его пины
# GPIO19/20 отданы под CAN.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Тик 1 мс, как в keypad_ctrl: ровные периоды опроса кнопок (10 мс) и UI (33 мс).
CONFIG_FREERTOS_HZ=1000

# Откат неудачного OTA.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Как в wifi-serv: путь /fontawesome/webfonts/s900.woff2 длиннее стандартных
# 32 байт имени SPIFFS, а браузеры шлют заголовки длиннее 512 байт.
CONFIG_SPIFFS_OBJ_NAME_LEN=48
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Картинки из раздела media (/media) читает LVGL через POSIX-драйвер:
# путь "M:/имя.bin" -> /media/имя.bin. Свой формат .bin - встроенный декодер.
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=77
CONFIG_LV_FS_POSIX_PATH="/media"
# Картинки целиком декодируются в RAM (PSRAM) один раз и лежат в кэше. Без этого
# декодер читает .bin из SPIFFS кусками при каждой перерисовке области - фон со
# стрелкой давал 5 fps. Кэш: фон до 922 КБ (ARGB8888) + стрелка + запас на экраны.
CONFIG_LV_BIN_DECODER_RAM_LOAD=y
CONFIG_LV_CACHE_DEF_SIZE=3145728
# Память LVGL - из общей кучи (большие блоки уходят в PSRAM), а не из пула 64 КБ:
# иначе кэш картинок и много экранов не поместятся.
CONFIG_LV_USE_CLIB_MALLOC=y

# Период обновления дисплея LVGL: по умолчанию 33 мс - потолок 30 fps. 16 мс - под
# частоту панели (~60 Гц); реальный fps определяет время рисования кадра.
CONFIG_LV_DEF_REFR_PERIOD=16
