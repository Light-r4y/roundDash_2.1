# ============================================================
# ESP-IDF / прошивка
# ============================================================

# Сборка (только каталоги ESP-IDF — tools/build/ это скрипты, их не трогать)
/build/
fw/build/
managed_components/
dependencies.lock

# sdkconfig генерируется из sdkconfig.defaults и содержит локальные пути —
# в репозиторий идёт только sdkconfig.defaults
sdkconfig
sdkconfig.old

CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Релизы tools/build/build.* — собираются заново из исходников
releases/

# Хеш веб-интерфейса, генерирует tools/build/gen_build_id.*
fw/www/.build_id

# Логи и дампы
*.log
coredump*.elf

# ============================================================
# Документация модуля (hw/)
# ============================================================

# Архивы большие и скачиваются по ссылке из hw/README.md
hw/**/*.zip

# ============================================================
# Инструменты и среда
# ============================================================

.vscode/
.idea/
.cache/
.clangd/
.venv/
__pycache__/
*.pyc

# ============================================================
# ОС
# ============================================================

Thumbs.db
desktop.ini
.DS_Store
